{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "project-dica",
  "version": "0.1.0",
  "identifier": "com.d-night.project-dica",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Proyecto DICA",
        "width": 680,
        "height": 400,
        "decorations": false,
        "resizable": false,
        "center": true,
        "shadow": true,
        "backgroundColor": "#0f0e0d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}